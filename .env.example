SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
PORT=3000
NODE_ENV=development
# Set to the verified reverse-proxy hop count in hosting settings; never use true.
TRUST_PROXY_HOPS=0
# Server-only. Never expose this in HTML, public scripts or /api/config.
SUPABASE_SECRET_KEY=
MAYA_SANDBOX_ENABLED=false
# Apply maya-reliability-setup.sql before enabling. Keep all app instances on the same writer mode.
MAYA_RELIABILITY_ENABLED=false
MAYA_SANDBOX_PUBLIC_DEMO=true
MAYA_SANDBOX_PUBLIC_KEY=
MAYA_SANDBOX_SECRET_KEY=
APP_BASE_URL=http://localhost:3000

# Optional Lalamove Philippines sandbox (server only)
LALAMOVE_SANDBOX_ENABLED=false
LALAMOVE_API_KEY=
LALAMOVE_API_SECRET=
LALAMOVE_PICKUP_ADDRESS=
LALAMOVE_PICKUP_LAT=
LALAMOVE_PICKUP_LNG=
LALAMOVE_TEST_PHONE=+639931797645

# Enable after applying supabase/order-expiry-setup.sql.
ORDER_EXPIRY_ENABLED=false
